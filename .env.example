# ================================================================
# Secure Telegram Browser Controller — конфигурация
# Скопируй этот файл в .env и заполни своими значениями
# НИКОГДА не коммить .env в Git
# ================================================================

# === Telegram ===
BOT_TOKEN=                          # Токен бота от @BotFather
ALLOWED_USER_ID=                    # Твой Telegram ID (узнать у @userinfobot)

# === Браузер ===
BROWSER_TYPE=chromium               # chromium | firefox | webkit
BROWSER_HEADLESS=false              # false = браузер виден на экране

# === Голос ===
WHISPER_MODEL=base                  # base (быстро) | small | medium (точнее)

# === Поиск ===
SEARCH_ENGINE=google                # google | duckduckgo

# === Безопасность ===
IDLE_TIMEOUT_MINUTES=10             # Закрыть браузер после N минут бездействия
STOP_CONFIRM_TIMEOUT_SECONDS=30     # Таймаут подтверждения /stop

# === Медиапульт (Этап 4.5) ===
DEFAULT_MEDIA_PLATFORM=rutube       # rutube | youtube | vk | ok
SEARCH_RESULTS_LIMIT=5              # Количество результатов в списке (max 10)
PLAYER_SEEK_SHORT_SEC=30            # Короткая перемотка (секунды)
PLAYER_SEEK_LONG_SEC=300            # Длинная перемотка (5 минут)

# === Управление компьютером (Этап 4.5) ===
POSITION_SAVE_INTERVAL_SEC=30       # Как часто сохранять позицию просмотра
MAX_HISTORY_ITEMS=50                # Максимум записей в истории просмотров

# === Логи ===
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
